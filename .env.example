# Contoh variabel lingkungan Easy-Vibe.
# Salin ke .env lalu sesuaikan.
# JANGAN commit file .env yang berisi nilai sebenarnya.

# Path ke direktori Web MCP Bridge (opsional, dipakai scripts/start-bridge.sh).
# Instalasi lewat install.fish menaruhnya di ~/.easy-vibe/web-mcp-bridge.
WEB_MCP_BRIDGE_DIR=../web-mcp-bridge

# Path absolut repository yang akan dikelola tool MCP.
# Gunakan garis miring /, mis. /home/nama/Easy-Vibe
EASY_VIBE_REPO_PATH=/home/CHANGE_ME/Easy-Vibe

# Port kontrol bridge (opsional). Fork Easy-Vibe memakai 8199 (launcher 8198).
EASY_VIBE_BRIDGE_CONTROL_PORT=8199

# Token GitHub (opsional). Dibaca install.fish bila tidak ada --github-token.
# EASY_VIBE_GITHUB_TOKEN=
