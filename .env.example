# Contoh variabel lingkungan Easy-Vibe.
# Salin ke .env lalu sesuaikan.
# JANGAN commit file .env yang berisi nilai sebenarnya.

# Path ke direktori Web MCP Bridge (opsional, dipakai scripts/start-bridge.sh)
WEB_MCP_BRIDGE_DIR=../web-mcp-bridge

# Path absolut repository yang akan dikelola tool MCP.
# Gunakan garis miring /, termasuk di Windows: C:/Users/nama/projects/Easy-Vibe
EASY_VIBE_REPO_PATH=C:/Users/CHANGE_ME/projects/Easy-Vibe

# Port bridge (opsional). Default 8099.
EASY_VIBE_BRIDGE_CONTROL_PORT=8099
